<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust our local CA (user trust store) so the app can talk https to
         the PC, and allow plain http on the LAN as an option. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>